<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_controls_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_controls_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_widget_dap"
        android:contentDescription="DAP Console" />

    <!-- Track & Folder Info -->
    <LinearLayout
        android:id="@+id/widget_controls_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_controls_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAP Console"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_controls_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready for SD Card Playback"
            android:textColor="#E0A938"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_controls_specs_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLAC | 00:00 / 00:00"
            android:textColor="#A0A3B0"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Buttons: Prev, Play/Pause, Next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous Track"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="Play/Pause"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next Track"
            android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>
